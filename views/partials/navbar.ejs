<!-- Modern Universal Navigation Bar Component -->
<nav x-data="{ mobileMenuOpen: false }" class="nav-glass sticky top-0 z-50 transition-colors duration-300">
  <div class="max-w-screen-xl px-4 sm:px-8 lg:px-12 mx-auto">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Logo & Brand -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-violet-600 via-purple-600 to-indigo-500 flex items-center justify-center shadow-md shadow-violet-500/25 group-hover:shadow-violet-500/40 group-hover:scale-105 transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-slate-900 dark:text-white text-xl font-bold tracking-tight">Edu<span class="text-violet-600 dark:text-violet-400">Verse</span></span>
          <span class="text-[10px] text-slate-500 dark:text-slate-400 tracking-wider font-medium uppercase -mt-1 hidden sm:block">Learn & Grow</span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <div class="hidden md:flex items-center space-x-1 lg:space-x-2 text-sm font-medium">
        <% const isHome = typeof currentPath !== 'undefined' && currentPath === '/'; %>
        <% const isCourses = typeof currentPath !== 'undefined' && currentPath.startsWith('/courses'); %>
        <% const isLeaderboard = typeof currentPath !== 'undefined' && currentPath.startsWith('/leaderboard'); %>
        <% const isContact = typeof currentPath !== 'undefined' && currentPath === '/contact'; %>
        <% const isAdminQuiz = typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/quiz'); %>
        <% const isAdminContacts = typeof currentPath !== 'undefined' && currentPath.startsWith('/contacts'); %>

        <a href="/" class="<%= isHome ? 'text-violet-600 dark:text-violet-400 font-semibold bg-violet-50 dark:bg-violet-500/10' : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100/70 dark:hover:bg-white/5' %> px-3 py-1.5 rounded-lg transition-all">Home</a>
        <a href="/courses" class="<%= isCourses ? 'text-violet-600 dark:text-violet-400 font-semibold bg-violet-50 dark:bg-violet-500/10' : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100/70 dark:hover:bg-white/5' %> px-3 py-1.5 rounded-lg transition-all">Courses</a>
        <a href="/leaderboard" class="<%= isLeaderboard ? 'text-violet-600 dark:text-violet-400 font-semibold bg-violet-50 dark:bg-violet-500/10' : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100/70 dark:hover:bg-white/5' %> px-3 py-1.5 rounded-lg transition-all">Leaderboard</a>
        <a href="/contact" class="<%= isContact ? 'text-violet-600 dark:text-violet-400 font-semibold bg-violet-50 dark:bg-violet-500/10' : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100/70 dark:hover:bg-white/5' %> px-3 py-1.5 rounded-lg transition-all">Contact</a>

        <% if (typeof user !== 'undefined' && user && user.role !== 'user') { %>
          <div class="h-4 w-px bg-slate-200 dark:bg-white/10 mx-1"></div>
          <a href="/admin/quiz" class="<%= isAdminQuiz ? 'text-violet-600 dark:text-violet-400 font-semibold bg-violet-50 dark:bg-violet-500/10' : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100/70 dark:hover:bg-white/5' %> px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-violet-500"></span>
            Admin
          </a>
          <a href="/contacts" class="<%= isAdminContacts ? 'text-violet-600 dark:text-violet-400 font-semibold bg-violet-50 dark:bg-violet-500/10' : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100/70 dark:hover:bg-white/5' %> px-3 py-1.5 rounded-lg transition-all">Queries</a>
        <% } %>
      </div>

      <!-- Right Header Actions (Desktop) -->
      <div class="hidden md:flex items-center space-x-3">
        <!-- Dark Mode Toggle Button -->
        <button @click="darkMode = !darkMode" 
                type="button" 
                class="w-10 h-10 rounded-xl flex items-center justify-center text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white bg-slate-100/80 dark:bg-white/5 hover:bg-slate-200/80 dark:hover:bg-white/10 border border-slate-200/80 dark:border-white/10 transition-all focus:outline-none"
                title="Toggle Dark / Light Mode"
                aria-label="Toggle Theme">
          <svg x-show="!darkMode" class="w-5 h-5 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
          </svg>
          <svg x-show="darkMode" x-cloak class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
        </button>

        <% if (typeof user !== 'undefined' && user) { %>
          <!-- User Profile Pill -->
          <a href="/profile" class="flex items-center gap-2 pl-2 pr-3 py-1.5 rounded-xl bg-slate-100/80 dark:bg-white/5 hover:bg-slate-200/80 dark:hover:bg-white/10 border border-slate-200/80 dark:border-white/10 transition-all group">
            <div class="w-7 h-7 rounded-lg bg-gradient-to-tr from-violet-500 to-indigo-500 text-white flex items-center justify-center text-xs font-bold shadow-sm">
              <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
            </div>
            <span class="text-xs font-semibold text-slate-700 dark:text-slate-200 group-hover:text-violet-600 dark:group-hover:text-violet-300">
              <%= user.name %>
            </span>
          </a>

          <!-- Logout Button -->
          <a href="/logout" 
             class="w-10 h-10 rounded-xl flex items-center justify-center text-slate-500 hover:text-red-600 dark:text-slate-400 dark:hover:text-red-400 bg-slate-100/80 dark:bg-white/5 hover:bg-red-50 dark:hover:bg-red-500/10 border border-slate-200/80 dark:border-white/10 transition-all"
             title="Logout" 
             aria-label="Logout">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
          </a>
        <% } else { %>
          <!-- Guest Auth Actions -->
          <a href="/login" class="text-sm font-semibold text-slate-700 dark:text-slate-300 hover:text-violet-600 dark:hover:text-white px-3 py-2 transition-all">Sign In</a>
          <a href="/register" class="btn-gradient text-xs font-semibold px-4 py-2.5 rounded-xl shadow-md transition-all">Get Started</a>
        <% } %>
      </div>

      <!-- Mobile Menu Button & Toggle -->
      <div class="flex items-center gap-2 md:hidden">
        <!-- Mobile Dark Mode Toggle -->
        <button @click="darkMode = !darkMode" 
                type="button" 
                class="w-9 h-9 rounded-lg flex items-center justify-center text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 focus:outline-none"
                aria-label="Toggle Theme">
          <svg x-show="!darkMode" class="w-4 h-4 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
          </svg>
          <svg x-show="darkMode" x-cloak class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
        </button>

        <!-- Hamburger Icon Button -->
        <button @click="mobileMenuOpen = !mobileMenuOpen" 
                type="button"
                class="w-9 h-9 rounded-lg flex items-center justify-center text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 focus:outline-none"
                aria-label="Open Navigation Menu">
          <svg x-show="!mobileMenuOpen" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
          </svg>
          <svg x-show="mobileMenuOpen" x-cloak class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Navigation Menu Sheet -->
  <div x-show="mobileMenuOpen" 
       x-cloak
       x-transition:enter="transition ease-out duration-200"
       x-transition:enter-start="opacity-0 -translate-y-2"
       x-transition:enter-end="opacity-100 translate-y-0"
       x-transition:leave="transition ease-in duration-150"
       x-transition:leave-start="opacity-100 translate-y-0"
       x-transition:leave-end="opacity-0 -translate-y-2"
       class="md:hidden border-t border-slate-200/80 dark:border-white/10 bg-white/95 dark:bg-[#0f0c29]/95 backdrop-blur-2xl px-4 py-4 space-y-2 shadow-2xl">
    
    <% const m_isHome = typeof currentPath !== 'undefined' && currentPath === '/'; %>
    <% const m_isCourses = typeof currentPath !== 'undefined' && currentPath.startsWith('/courses'); %>
    <% const m_isLeaderboard = typeof currentPath !== 'undefined' && currentPath.startsWith('/leaderboard'); %>
    <% const m_isContact = typeof currentPath !== 'undefined' && currentPath === '/contact'; %>
    <% const m_isAdminQuiz = typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/quiz'); %>
    <% const m_isAdminContacts = typeof currentPath !== 'undefined' && currentPath.startsWith('/contacts'); %>

    <a href="/" class="flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium <%= m_isHome ? 'bg-violet-50 dark:bg-violet-500/15 text-violet-600 dark:text-violet-400 font-semibold' : 'text-slate-700 dark:text-slate-300' %>">
      <span>Home</span>
    </a>
    <a href="/courses" class="flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium <%= m_isCourses ? 'bg-violet-50 dark:bg-violet-500/15 text-violet-600 dark:text-violet-400 font-semibold' : 'text-slate-700 dark:text-slate-300' %>">
      <span>Courses</span>
    </a>
    <a href="/leaderboard" class="flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium <%= m_isLeaderboard ? 'bg-violet-50 dark:bg-violet-500/15 text-violet-600 dark:text-violet-400 font-semibold' : 'text-slate-700 dark:text-slate-300' %>">
      <span>Leaderboard</span>
    </a>
    <a href="/contact" class="flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium <%= m_isContact ? 'bg-violet-50 dark:bg-violet-500/15 text-violet-600 dark:text-violet-400 font-semibold' : 'text-slate-700 dark:text-slate-300' %>">
      <span>Contact Us</span>
    </a>

    <% if (typeof user !== 'undefined' && user && user.role !== 'user') { %>
      <div class="pt-2 border-t border-slate-200 dark:border-white/10">
        <span class="px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400">Admin Area</span>
        <a href="/admin/quiz" class="flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium <%= m_isAdminQuiz ? 'bg-violet-50 dark:bg-violet-500/15 text-violet-600 dark:text-violet-400 font-semibold' : 'text-slate-700 dark:text-slate-300' %>">
          <span>Manage Quizzes</span>
        </a>
        <a href="/contacts" class="flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium <%= m_isAdminContacts ? 'bg-violet-50 dark:bg-violet-500/15 text-violet-600 dark:text-violet-400 font-semibold' : 'text-slate-700 dark:text-slate-300' %>">
          <span>Contact Queries</span>
        </a>
      </div>
    <% } %>

    <div class="pt-3 border-t border-slate-200 dark:border-white/10">
      <% if (typeof user !== 'undefined' && user) { %>
        <div class="flex items-center justify-between px-3 py-2 bg-slate-50 dark:bg-white/5 rounded-xl mb-2">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-violet-500 to-indigo-500 text-white flex items-center justify-center text-xs font-bold">
              <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
            </div>
            <div>
              <p class="text-xs font-bold text-slate-800 dark:text-white"><%= user.name %></p>
              <p class="text-[10px] text-slate-500 dark:text-slate-400"><%= user.email || user.role %></p>
            </div>
          </div>
          <a href="/profile" class="text-xs text-violet-600 dark:text-violet-400 font-semibold">Profile</a>
        </div>
        <a href="/logout" class="flex items-center justify-center gap-2 w-full px-4 py-2.5 rounded-xl text-sm font-semibold text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-500/10 hover:bg-red-100 transition-colors">
          <span>Log Out</span>
        </a>
      <% } else { %>
        <div class="grid grid-cols-2 gap-2 pt-1">
          <a href="/login" class="flex items-center justify-center px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-white/10">Sign In</a>
          <a href="/register" class="btn-gradient flex items-center justify-center px-4 py-2.5 rounded-xl text-sm font-semibold text-white shadow">Sign Up</a>
        </div>
      <% } %>
    </div>

  </div>
</nav>
