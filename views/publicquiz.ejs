<!DOCTYPE html>
<html lang="en" 
      x-data="{ darkMode: localStorage.getItem('darkMode') === 'true' || (!('darkMode' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches) }" 
      x-init="$watch('darkMode', val => localStorage.setItem('darkMode', val)); darkMode ? document.documentElement.classList.add('dark') : document.documentElement.classList.remove('dark')" 
      :class="{ 'dark': darkMode }">
<head>
  <%- include('partials/head', { title: 'Quizzes & Challenges' }) %>
</head>

<body class="dots-pattern bg-slate-50 dark:bg-[#0f0c29] text-slate-800 dark:text-white transition-colors duration-300 min-h-screen flex flex-col"
      :style="darkMode ? 'background: linear-gradient(180deg, #0f0c29 0%, #1a1440 30%, #1e1848 60%, #24243e 100%);' : 'background: #f8fafc;'">

  <!-- Ambient Background Glow -->
  <div class="orb orb-purple w-96 h-96 -top-20 -left-20"></div>
  <div class="orb orb-pink w-80 h-80 top-1/2 -right-20"></div>

  <!-- Navbar Component -->
  <%- include('partials/navbar') %>

  <!-- Main Content Area -->
  <main class="flex-1 max-w-screen-xl w-full px-4 sm:px-8 lg:px-12 mx-auto py-8 relative z-10">
    
    <!-- Hero / Header Banner -->
    <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-100 dark:bg-violet-500/15 border border-violet-200 dark:border-violet-500/30 text-violet-700 dark:text-violet-300 text-xs font-semibold mb-3">
          <span>🎯 Interactive Knowledge Hub</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Explore Quizzes & Challenges
        </h1>
        <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">
          Sharpen your skills, gauge your learning curve, and track your progress in real-time.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a href="/courses" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 hover:border-violet-400 transition-all flex items-center gap-1.5 shadow-sm">
          <svg class="w-4 h-4 text-violet-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
          Browse Courses
        </a>
        <a href="/leaderboard" class="btn-gradient px-4 py-2 rounded-xl text-xs font-semibold shadow-md flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
          View Rankings
        </a>
      </div>
    </div>

    <!-- Layout Grid: Analytics & Quiz Cards -->
    <div class="flex flex-col lg:flex-row gap-8">
      
      <!-- Analytics Sidebar -->
      <aside class="lg:w-80 flex-shrink-0">
        <div class="glass-card rounded-2xl p-6 lg:sticky lg:top-28 space-y-6">
          <div class="flex items-center justify-between border-b border-slate-200/80 dark:border-white/10 pb-4">
            <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <svg class="w-5 h-5 text-violet-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
              Your Performance
            </h2>
            <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-violet-100 dark:bg-violet-500/20 text-violet-700 dark:text-violet-300">Live</span>
          </div>

          <!-- Quizzes Completed Gauge -->
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-white/[0.03] border border-slate-200/70 dark:border-white/5 text-center">
            <div class="relative w-28 h-28 mx-auto">
              <svg class="w-full h-full transform -rotate-90" viewBox="0 0 36 36">
                <circle class="text-slate-200 dark:text-white/10" stroke-width="3.5" stroke="currentColor" fill="none" r="16" cx="18" cy="18" />
                <circle class="text-violet-500 transition-all duration-700 ease-out" 
                        stroke-width="3.5" 
                        stroke="currentColor" 
                        fill="none" 
                        r="16" 
                        cx="18" 
                        cy="18" 
                        stroke-dasharray="100"
                        stroke-dashoffset="<%= totalQuizzes > 0 ? Math.max(0, 100 - ((quizzesAttempted / totalQuizzes) * 100)) : 100 %>"
                        stroke-linecap="round" />
              </svg>
              <div class="absolute inset-0 flex flex-col items-center justify-center">
                <span class="text-xl font-bold text-violet-600 dark:text-violet-400">
                  <%= totalQuizzes > 0 ? ((quizzesAttempted / totalQuizzes) * 100).toFixed(0) : 0 %>%
                </span>
                <span class="text-[9px] uppercase tracking-wider text-slate-400 font-semibold">Done</span>
              </div>
            </div>
            <p class="mt-3 text-slate-800 dark:text-slate-200 text-sm font-semibold">Quizzes Attempted</p>
            <p class="text-slate-500 dark:text-slate-400 text-xs">
              <span class="font-bold text-violet-600 dark:text-violet-400"><%= quizzesAttempted %></span> completed out of <%= totalQuizzes %> available
            </p>
          </div>

          <!-- Average Accuracy Gauge -->
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-white/[0.03] border border-slate-200/70 dark:border-white/5 text-center">
            <div class="relative w-28 h-28 mx-auto">
              <svg class="w-full h-full transform -rotate-90" viewBox="0 0 36 36">
                <circle class="text-slate-200 dark:text-white/10" stroke-width="3.5" stroke="currentColor" fill="none" r="16" cx="18" cy="18" />
                <circle class="text-emerald-500 transition-all duration-700 ease-out" 
                        stroke-width="3.5" 
                        stroke="currentColor" 
                        fill="none" 
                        r="16" 
                        cx="18" 
                        cy="18" 
                        stroke-dasharray="100" 
                        stroke-dashoffset="<%= Math.max(0, 100 - (Number(averageAccuracy) || 0)) %>"
                        stroke-linecap="round" />
              </svg>
              <div class="absolute inset-0 flex flex-col items-center justify-center">
                <span class="text-xl font-bold text-emerald-600 dark:text-emerald-400">
                  <%= averageAccuracy !== null && averageAccuracy !== undefined ? averageAccuracy : '0' %>%
                </span>
                <span class="text-[9px] uppercase tracking-wider text-slate-400 font-semibold">Avg</span>
              </div>
            </div>
            <p class="mt-3 text-slate-800 dark:text-slate-200 text-sm font-semibold">Average Accuracy</p>
            <p class="text-slate-500 dark:text-slate-400 text-xs">Calculated across all finished attempts</p>
          </div>

        </div>
      </aside>

      <!-- Quizzes List Content -->
      <section class="flex-1">
        <div class="glass-card rounded-2xl p-6 sm:p-8">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
              Available Quizzes (<%= quizzes.length %>)
            </h2>
          </div>

          <% if (quizzes && quizzes.length > 0) { %>
            <div class="space-y-4">
              <% quizzes.forEach((quiz, index) => { %>
                <div class="glass-item rounded-2xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                  <div class="space-y-1.5 flex-1">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="w-6 h-6 rounded-lg bg-violet-100 dark:bg-violet-500/20 text-violet-700 dark:text-violet-300 flex items-center justify-center text-xs font-bold flex-shrink-0">
                        <%= index + 1 %>
                      </span>
                      <h3 class="text-base font-bold text-slate-900 dark:text-white">
                        <%= quiz.quiz_name %>
                      </h3>
                      <% if (quiz.user_score !== null && quiz.user_score !== undefined) { %>
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300">
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                          Score: <%= quiz.user_score %>%
                        </span>
                      <% } %>
                    </div>
                    <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed pl-8">
                      <%= quiz.description || 'Test and reinforce your understanding with this quiz challenge.' %>
                    </p>
                  </div>

                  <div class="sm:text-right flex items-center sm:flex-col justify-end gap-2 flex-shrink-0 pl-8 sm:pl-0">
                    <% if (quiz.reattempt === 1 || quiz.user_score === null) { %>
                      <a href="/quiz/<%= quiz.id %>" 
                         class="btn-gradient px-5 py-2.5 rounded-xl text-xs font-semibold shadow-md inline-flex items-center gap-1.5">
                        <span><%= quiz.user_score !== null ? 'Re-take Quiz' : 'Take Quiz' %></span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                      </a>
                    <% } else { %>
                      <span class="px-4 py-2 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-white/10 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-white/5 inline-flex items-center gap-1">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Completed
                      </span>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="text-center py-16 px-4">
              <div class="w-16 h-16 rounded-2xl bg-violet-100 dark:bg-violet-500/15 text-violet-600 dark:text-violet-400 flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">No quizzes available right now</h3>
              <p class="text-slate-500 dark:text-slate-400 text-sm max-w-sm mx-auto mb-6">
                Our instructors are crafting new quiz assessments. Check back soon or browse courses in the meantime!
              </p>
              <a href="/courses" class="btn-gradient px-5 py-2.5 rounded-xl text-xs font-semibold shadow-md inline-block">
                Explore Available Courses
              </a>
            </div>
          <% } %>

        </div>
      </section>

    </div>
  </main>

  <!-- Footer Component -->
  <%- include('partials/footer') %>

</body>
</html>