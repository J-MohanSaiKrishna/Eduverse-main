<!DOCTYPE html>
<html lang="en" x-data="{ darkMode: localStorage.getItem('darkMode') === 'true' || (!('darkMode' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches) }" x-init="$watch('darkMode', val => localStorage.setItem('darkMode', val)); darkMode ? document.documentElement.classList.add('dark') : document.documentElement.classList.remove('dark')" :class="{ 'dark': darkMode }">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quizzes — EduVerse</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="shortcut icon"
    href="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTAQHwjXyAiIxUCnh3-cFywq0K4ZmDFo20YAw&s">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet">
  <style>
    * {
      font-family: 'Poppins', sans-serif;
    }

    /* Hardcoded body background removed for dark mode */

    .nav-glass {
      background: rgba(15, 12, 41, 0.85);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.06);
      backdrop-filter: blur(15px);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .quiz-item {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.06);
      transition: all 0.3s;
    }

    .quiz-item:hover {
      background: rgba(139, 92, 246, 0.08);
      border-color: rgba(139, 92, 246, 0.2);
      transform: translateX(4px);
    }

    .dots-pattern {
      background-image: radial-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px);
      background-size: 30px 30px;
    }

    .btn-quiz {
      background: linear-gradient(135deg, #667eea, #764ba2);
      transition: all 0.3s;
    }

    .btn-quiz:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
    }
  </style>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>

<body class="dots-pattern  bg-gray-50 dark:bg-[#0f0c29] text-gray-800 dark:text-white transition-colors duration-300 min-h-screen" :style="darkMode ? 'background: linear-gradient(180deg, #0f0c29 0%, #1a1440 30%, #1e1848 60%, #24243e 100%);' : 'background: #f8fafc;'">

  <!-- Navbar -->
  <nav class="nav-glass p-4 sticky top-0 z-50">
    <div class="max-w-screen-xl p-2 sm:px-16 mx-auto flex justify-between items-center">
      <a href="/" class="flex items-center gap-2">
        <div
          class="w-10 h-10 rounded-xl bg-gradient-to-br from-violet-500 to-purple-600 flex items-center justify-center shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24"
            stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <span class="text-white text-xl font-bold">EduVerse</span>
      </a>
      <div class="hidden md:flex items-center space-x-6 text-sm font-medium">
        <a href="/" class="text-gray-400 hover:text-white transition">Home</a>
        <% if (user && user.role !=='user' ) { %>
          <a href="/admin/quiz" class="text-gray-400 hover:text-white transition">Admin</a>
          <a href="/contacts" class="text-gray-400 hover:text-white transition">Queries</a>
          <% } %>
            <a href="/courses" class="text-gray-400 hover:text-white transition">Courses</a>
            <a href="/leaderboard" class="text-violet-400 font-semibold">Results</a>
            <a href="/contact" class="text-gray-400 hover:text-white transition">Contact</a>
            <a href="/profile" class="text-gray-400 hover:text-white transition">
              <span
                class="bg-violet-500/20 border border-violet-500/30 text-violet-300 px-3 py-1 rounded-lg text-xs font-semibold">
                <%= user.name %>
              </span>
            </a>
            
                <!-- Dark Mode Toggle -->
                <div @click="darkMode = !darkMode" class="dark-mode-toggle text-gray-600 dark:text-gray-300 cursor-pointer p-2 rounded-full hover:bg-violet-500/10 transition-colors" title="Toggle Dark/Light Mode">
                    <svg x-show="!darkMode" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                    <svg x-show="darkMode" x-cloak class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                </div>
                <a href="/logout" class="text-gray-500 hover:text-red-400 transition">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
            </a>
      </div>
    </div>
  </nav>

  <div class="max-w-screen-xl p-4 sm:px-16 mx-auto py-8">
    <h1 class="text-3xl font-extrabold mb-6">📝 All Quizzes</h1>

    <div class="flex flex-col lg:flex-row gap-6">
      <!-- Analytics Sidebar -->
      <div class="lg:w-72 flex-shrink-0">
        <div class="glass-card rounded-2xl p-6 text-center sticky top-24">
          <h2 class="text-lg font-bold mb-6 text-white">Quiz Analytics</h2>

          <!-- Attempted Progress -->
          <div class="mb-8">
            <div class="relative w-28 h-28 mx-auto">
              <svg class="w-full h-full transform -rotate-90" viewBox="0 0 36 36">
                <circle class="text-white/10" stroke-width="3.5" stroke="currentColor" fill="none" r="16" cx="18"
                  cy="18" />
                <circle class="text-violet-500" stroke-width="3.5" stroke="currentColor" fill="none" r="16" cx="18"
                  cy="18" stroke-dasharray="100"
                  stroke-dashoffset="<%= totalQuizzes > 0 ? 100 - ((quizzesAttempted / totalQuizzes) * 100) : 100 %>"
                  stroke-linecap="round" />
              </svg>
              <div class="absolute inset-0 flex items-center justify-center">
                <span class="text-xl font-bold text-violet-400">
                  <%= totalQuizzes> 0 ? ((quizzesAttempted / totalQuizzes) * 100).toFixed(0) : 0 %>%
                </span>
              </div>
            </div>
            <p class="mt-3 text-gray-400 text-sm font-medium">Quizzes Attempted</p>
            <p class="text-gray-500 text-xs">
              <%= quizzesAttempted %> of <%= totalQuizzes %>
            </p>
          </div>

          <!-- Accuracy -->
          <div>
            <div class="relative w-28 h-28 mx-auto">
              <svg class="w-full h-full transform -rotate-90" viewBox="0 0 36 36">
                <circle class="text-white/10" stroke-width="3.5" stroke="currentColor" fill="none" r="16" cx="18"
                  cy="18" />
                <circle class="text-emerald-500" stroke-width="3.5" stroke="currentColor" fill="none" r="16" cx="18"
                  cy="18" stroke-dasharray="100" stroke-dashoffset="<%= 100 - averageAccuracy %>"
                  stroke-linecap="round" />
              </svg>
              <div class="absolute inset-0 flex items-center justify-center">
                <span class="text-xl font-bold text-emerald-400">
                  <%= averageAccuracy !==null ? averageAccuracy : '0' %>%
                </span>
              </div>
            </div>
            <p class="mt-3 text-gray-400 text-sm font-medium">Average Accuracy</p>
          </div>
        </div>
      </div>

      <!-- Quiz List -->
      <div class="flex-1">
        <div class="glass-card rounded-2xl p-6">
          <% if (quizzes.length> 0) { %>
            <div class="space-y-3">
              <% quizzes.forEach((quiz, index)=> { %>
                <div class="quiz-item rounded-xl p-5 flex justify-between items-center">
                  <div>
                    <h2 class="text-base font-semibold text-white">
                      <%= index + 1 %>. <%= quiz.quiz_name %>
                    </h2>
                    <p class="text-gray-500 text-sm mt-1">
                      <%= quiz.description %>
                    </p>
                  </div>
                  <div class="text-right flex-shrink-0 ml-4">
                    <% if (quiz.user_score !==null) { %>
                      <p class="text-emerald-400 text-sm font-semibold mb-2">Score: <%= quiz.user_score %>%</p>
                      <% } %>
                        <% if (quiz.reattempt===1 || quiz.user_score===null) { %>
                          <a href="/quiz/<%= quiz.id %>"
                            class="btn-quiz text-white px-5 py-2 rounded-xl text-sm font-semibold inline-block">
                            Take Quiz
                          </a>
                          <% } else { %>
                            <span
                              class="bg-white/10 text-gray-400 px-4 py-2 rounded-xl text-sm font-medium">Attempted</span>
                            <% } %>
                  </div>
                </div>
                <% }) %>
            </div>
            <% } else { %>
              <div class="text-center py-12">
                <div class="w-16 h-16 rounded-2xl bg-violet-500/10 flex items-center justify-center mx-auto mb-4">
                  <svg class="w-8 h-8 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                  </svg>
                </div>
                <p class="text-gray-400 font-medium">No quizzes available yet.</p>
              </div>
              <% } %>
        </div>
      </div>
    </div>
  </div>
</body>

</html>