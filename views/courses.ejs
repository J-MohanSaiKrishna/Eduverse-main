<!DOCTYPE html>
<html lang="en" 
      x-data="{ darkMode: localStorage.getItem('darkMode') === 'true' || (!('darkMode' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches) }" 
      x-init="$watch('darkMode', val => localStorage.setItem('darkMode', val)); darkMode ? document.documentElement.classList.add('dark') : document.documentElement.classList.remove('dark')" 
      :class="{ 'dark': darkMode }">

<head>
    <%- include('partials/head', { title: 'Free Premium Courses' }) %>
    <style>
        .hero-gradient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 40%, #f093fb 100%);
            position: relative;
            overflow: hidden;
        }
        .hero-gradient::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 20% 50%, rgba(255, 255, 255, 0.15) 0%, transparent 50%),
                        radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.1) 0%, transparent 40%);
        }
        .topic-btn {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .topic-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px -5px rgba(139, 92, 246, 0.2);
        }
        .course-card {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .course-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 35px -5px rgba(139, 92, 246, 0.15);
        }
        .badge-free {
            background: linear-gradient(135deg, #43e97b, #38f9d7);
            color: #0f0c29;
        }
        .category-badge {
            background: rgba(139, 92, 246, 0.2);
            border: 1px solid rgba(139, 92, 246, 0.4);
            color: #8b5cf6;
        }
        .dark .category-badge {
            color: #c4b5fd;
        }
        .img-overlay {
            background: linear-gradient(to top, rgba(15, 12, 41, 0.85) 0%, transparent 60%);
        }
    </style>
</head>

<body class="bg-slate-50 dark:bg-[#0f0c29] text-slate-800 dark:text-white transition-colors duration-300 min-h-screen flex flex-col"
      :style="darkMode ? 'background: linear-gradient(180deg, #0f0c29 0%, #1a1440 30%, #1e1848 60%, #24243e 100%);' : 'background: #f8fafc;'">

    <!-- Navbar Component -->
    <%- include('partials/navbar') %>

    <!-- Hero Section -->
    <section class="hero-gradient text-white py-16 sm:py-20 relative">
        <div class="max-w-screen-xl mx-auto px-4 sm:px-8 lg:px-12 text-center relative z-10">
            <div class="inline-flex items-center gap-2 bg-white/15 backdrop-blur-md border border-white/20 rounded-full px-4 py-1.5 text-xs font-semibold mb-6 shadow-sm">
                <span class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></span>
                <span class="text-white/95">
                    <%= courses.length %> Premium Courses Free Forever
                </span>
            </div>
            <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold mb-4 tracking-tight drop-shadow-sm">
                Free Premium Courses
            </h1>
            <p class="text-base sm:text-lg opacity-90 max-w-2xl mx-auto leading-relaxed font-normal">
                Master today's most in-demand skills with video lectures, hands-on projects, and interactive quizzes — zero fees, endless growth.
            </p>
        </div>
    </section>

    <!-- Main Filtering & Courses Catalog Component (Unified Scope) -->
    <main class="flex-1 max-w-screen-xl w-full mx-auto px-4 sm:px-8 lg:px-12 -mt-8 relative z-10 mb-16" x-data="courseFilter()">
        
        <!-- Quick Topic Filter Pills -->
        <div class="glass-card rounded-2xl p-6 mb-8 shadow-xl">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-sm font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-2">
                    <svg class="w-4 h-4 text-violet-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
                    Popular Topics
                </h2>
                <span class="text-xs text-slate-400">Click to filter instantly</span>
            </div>
            <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-12 gap-2.5">
                <button @click="quickFilter('python')" class="topic-btn p-2.5 rounded-xl text-center bg-slate-50 dark:bg-white/5 hover:bg-violet-50 dark:hover:bg-violet-500/20 border border-slate-200/80 dark:border-white/10 group">
                    <div class="text-xl mb-1 group-hover:scale-110 transition-transform">🐍</div>
                    <div class="text-[11px] font-semibold text-slate-700 dark:text-slate-200">Python</div>
                </button>
                <button @click="quickFilter('javascript')" class="topic-btn p-2.5 rounded-xl text-center bg-slate-50 dark:bg-white/5 hover:bg-violet-50 dark:hover:bg-violet-500/20 border border-slate-200/80 dark:border-white/10 group">
                    <div class="text-xl mb-1 group-hover:scale-110 transition-transform">⚡</div>
                    <div class="text-[11px] font-semibold text-slate-700 dark:text-slate-200">JavaScript</div>
                </button>
                <button @click="quickFilter('java')" class="topic-btn p-2.5 rounded-xl text-center bg-slate-50 dark:bg-white/5 hover:bg-violet-50 dark:hover:bg-violet-500/20 border border-slate-200/80 dark:border-white/10 group">
                    <div class="text-xl mb-1 group-hover:scale-110 transition-transform">☕</div>
                    <div class="text-[11px] font-semibold text-slate-700 dark:text-slate-200">Java</div>
                </button>
                <button @click="quickFilter('web')" class="topic-btn p-2.5 rounded-xl text-center bg-slate-50 dark:bg-white/5 hover:bg-violet-50 dark:hover:bg-violet-500/20 border border-slate-200/80 dark:border-white/10 group">
                    <div class="text-xl mb-1 group-hover:scale-110 transition-transform">🌐</div>
                    <div class="text-[11px] font-semibold text-slate-700 dark:text-slate-200">Web Dev</div>
                </button>
                <button @click="quickFilter('artificial')" class="topic-btn p-2.5 rounded-xl text-center bg-slate-50 dark:bg-white/5 hover:bg-violet-50 dark:hover:bg-violet-500/20 border border-slate-200/80 dark:border-white/10 group">
                    <div class="text-xl mb-1 group-hover:scale-110 transition-transform">🤖</div>
                    <div class="text-[11px] font-semibold text-slate-700 dark:text-slate-200">AI & ML</div>
                </button>
                <button @click="quickFilter('data')" class="topic-btn p-2.5 rounded-xl text-center bg-slate-50 dark:bg-white/5 hover:bg-violet-50 dark:hover:bg-violet-500/20 border border-slate-200/80 dark:border-white/10 group">
                    <div class="text-xl mb-1 group-hover:scale-110 transition-transform">📊</div>
                    <div class="text-[11px] font-semibold text-slate-700 dark:text-slate-200">Data Sci</div>
                </button>
                <button @click="quickFilter('cyber')" class="topic-btn p-2.5 rounded-xl text-center bg-slate-50 dark:bg-white/5 hover:bg-violet-50 dark:hover:bg-violet-500/20 border border-slate-200/80 dark:border-white/10 group">
                    <div class="text-xl mb-1 group-hover:scale-110 transition-transform">🔒</div>
                    <div class="text-[11px] font-semibold text-slate-700 dark:text-slate-200">Security</div>
                </button>
                <button @click="quickFilter('mobile')" class="topic-btn p-2.5 rounded-xl text-center bg-slate-50 dark:bg-white/5 hover:bg-violet-50 dark:hover:bg-violet-500/20 border border-slate-200/80 dark:border-white/10 group">
                    <div class="text-xl mb-1 group-hover:scale-110 transition-transform">📱</div>
                    <div class="text-[11px] font-semibold text-slate-700 dark:text-slate-200">Mobile</div>
                </button>
                <button @click="quickFilter('cloud')" class="topic-btn p-2.5 rounded-xl text-center bg-slate-50 dark:bg-white/5 hover:bg-violet-50 dark:hover:bg-violet-500/20 border border-slate-200/80 dark:border-white/10 group">
                    <div class="text-xl mb-1 group-hover:scale-110 transition-transform">☁️</div>
                    <div class="text-[11px] font-semibold text-slate-700 dark:text-slate-200">Cloud</div>
                </button>
                <button @click="quickFilter('design')" class="topic-btn p-2.5 rounded-xl text-center bg-slate-50 dark:bg-white/5 hover:bg-violet-50 dark:hover:bg-violet-500/20 border border-slate-200/80 dark:border-white/10 group">
                    <div class="text-xl mb-1 group-hover:scale-110 transition-transform">🎨</div>
                    <div class="text-[11px] font-semibold text-slate-700 dark:text-slate-200">Design</div>
                </button>
                <button @click="quickFilter('marketing')" class="topic-btn p-2.5 rounded-xl text-center bg-slate-50 dark:bg-white/5 hover:bg-violet-50 dark:hover:bg-violet-500/20 border border-slate-200/80 dark:border-white/10 group">
                    <div class="text-xl mb-1 group-hover:scale-110 transition-transform">📢</div>
                    <div class="text-[11px] font-semibold text-slate-700 dark:text-slate-200">Marketing</div>
                </button>
                <button @click="quickFilter('programming')" class="topic-btn p-2.5 rounded-xl text-center bg-slate-50 dark:bg-white/5 hover:bg-violet-50 dark:hover:bg-violet-500/20 border border-slate-200/80 dark:border-white/10 group">
                    <div class="text-xl mb-1 group-hover:scale-110 transition-transform">💻</div>
                    <div class="text-[11px] font-semibold text-slate-700 dark:text-slate-200">C / C++</div>
                </button>
            </div>
        </div>

        <!-- Search Bar & Category Dropdown -->
        <div class="glass-card rounded-2xl p-5 mb-8">
            <div class="flex flex-col md:flex-row gap-4">
                <div class="flex-1 relative">
                    <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <input type="text" 
                           x-model="searchQuery" 
                           placeholder="Search courses by title, keywords, or topics..."
                           class="input-field w-full pl-12 pr-4 py-3 rounded-xl text-sm font-medium">
                </div>
                <div class="md:w-64">
                    <select x-model="categoryFilter"
                            class="input-field w-full px-4 py-3 rounded-xl text-sm font-medium">
                        <option value="all">All Categories</option>
                        <option value="Python">Python</option>
                        <option value="JavaScript">JavaScript</option>
                        <option value="Web Development">Web Development</option>
                        <option value="Java">Java</option>
                        <option value="Artificial Intelligence">AI & Machine Learning</option>
                        <option value="Data Science">Data Science</option>
                        <option value="Cybersecurity">Cybersecurity</option>
                        <option value="Mobile Development">Mobile Dev</option>
                        <option value="Cloud Computing">Cloud & DevOps</option>
                        <option value="Design">Design & UI/UX</option>
                        <option value="Digital Marketing">Marketing</option>
                        <option value="Programming">C / C++</option>
                    </select>
                </div>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-200/80 dark:border-white/10 flex items-center justify-between text-xs">
                <p class="text-slate-500 dark:text-slate-400">
                    Showing <span class="font-bold text-violet-600 dark:text-violet-400" x-text="filteredCourses().length"></span> courses
                </p>
                <button @click="resetFilters()"
                        x-show="searchQuery || categoryFilter !== 'all'"
                        class="text-violet-600 dark:text-violet-400 hover:underline font-semibold flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                    Reset Filters
                </button>
            </div>
        </div>

        <!-- Course Cards Grid -->
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            <template x-for="(course, index) in filteredCourses()" :key="course.id || index">
                <div class="course-card glass-card rounded-2xl flex flex-col justify-between overflow-hidden group">
                    <div>
                        <div class="relative overflow-hidden aspect-video bg-slate-900">
                            <img :src="course.image" :alt="course.name"
                                 class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                            <div class="img-overlay absolute inset-0"></div>
                            
                            <!-- Badges -->
                            <div class="absolute top-3 right-3 badge-free px-2.5 py-1 rounded-full text-[10px] font-extrabold tracking-wider uppercase shadow-md">
                                100% Free
                            </div>
                            <div class="absolute bottom-3 left-3">
                                <span class="category-badge text-[11px] px-3 py-1 rounded-full font-semibold backdrop-blur-md"
                                      x-text="course.category"></span>
                            </div>
                        </div>

                        <div class="p-6">
                            <h2 class="text-base font-bold text-slate-900 dark:text-white mb-2 line-clamp-2 leading-snug group-hover:text-violet-600 dark:group-hover:text-violet-400 transition-colors" x-text="course.name"></h2>
                            <p class="text-slate-500 dark:text-slate-400 text-xs mb-4 line-clamp-2 leading-relaxed"
                               x-text="course.description"></p>
                            <div class="flex items-center gap-2">
                                <span class="text-slate-400 dark:text-slate-500 line-through text-xs">$<span x-text="course.actual_price_usd || '199.99'"></span></span>
                                <span class="text-emerald-600 dark:text-emerald-400 font-extrabold text-base">FREE</span>
                            </div>
                        </div>
                    </div>

                    <!-- Card Actions -->
                    <div class="p-6 pt-0 mt-auto">
                        <div class="grid grid-cols-3 gap-2 pt-4 border-t border-slate-200/80 dark:border-white/10">
                            <a :href="course.url" target="_blank"
                               class="btn-gradient px-2 py-2 rounded-xl text-center font-semibold text-xs flex items-center justify-center gap-1 shadow-sm">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                                <span>Enroll</span>
                            </a>
                            <a :href="course.video_url" target="_blank"
                               class="px-2 py-2 rounded-xl text-center font-semibold text-xs flex items-center justify-center gap-1 bg-rose-50 dark:bg-rose-500/15 text-rose-600 dark:text-rose-300 border border-rose-200 dark:border-rose-500/30 hover:bg-rose-100 transition-colors">
                                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
                                <span>Watch</span>
                            </a>
                            <a :href="'/quiz/' + course.id"
                               class="px-2 py-2 rounded-xl text-center font-semibold text-xs flex items-center justify-center gap-1 bg-emerald-50 dark:bg-emerald-500/15 text-emerald-600 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-500/30 hover:bg-emerald-100 transition-colors">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                <span>Quiz</span>
                            </a>
                        </div>
                    </div>
                </div>
            </template>
        </div>

        <!-- No Results Fallback -->
        <div x-show="filteredCourses().length === 0" class="text-center py-20">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-violet-100 dark:bg-violet-500/15 text-violet-600 dark:text-violet-400 mb-4">
                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">No courses matched your query</h3>
            <p class="text-slate-500 dark:text-slate-400 text-sm max-w-sm mx-auto mb-4">
                Try searching for broader keywords or clear your active category filters.
            </p>
            <button @click="resetFilters()" class="btn-gradient px-4 py-2 rounded-xl text-xs font-semibold">
                Reset All Filters
            </button>
        </div>

    </main>

    <!-- Footer Component -->
    <%- include('partials/footer') %>

    <div id="course-data" style="display:none">
        <%= JSON.stringify(courses) %>
    </div>
    <script>
        var _courseData = JSON.parse(document.getElementById('course-data').textContent || '[]');
        function courseFilter() {
            return {
                searchQuery: '',
                categoryFilter: 'all',
                courses: _courseData,
                filteredCourses() {
                    let filtered = this.courses;
                    if (this.searchQuery) {
                        const query = this.searchQuery.toLowerCase();
                        filtered = filtered.filter(function (course) {
                            return (course.name && course.name.toLowerCase().includes(query)) ||
                                   (course.category && course.category.toLowerCase().includes(query)) ||
                                   (course.description && course.description.toLowerCase().includes(query));
                        });
                    }
                    if (this.categoryFilter !== 'all') {
                        var cat = this.categoryFilter.toLowerCase();
                        filtered = filtered.filter(function (course) {
                            return course.category && course.category.toLowerCase().includes(cat);
                        });
                    }
                    return filtered;
                },
                resetFilters() {
                    this.searchQuery = '';
                    this.categoryFilter = 'all';
                },
                quickFilter(query) {
                    this.searchQuery = query;
                    this.categoryFilter = 'all';
                }
            }
        }
    </script>
</body>
</html>