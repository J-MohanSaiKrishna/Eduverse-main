<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Leaderboard — EduVerse</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="shortcut icon"
    href="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTAQHwjXyAiIxUCnh3-cFywq0K4ZmDFo20YAw&s">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet">
  <style>
    * {
      font-family: 'Poppins', sans-serif;
    }

    body {
      background: linear-gradient(180deg, #0f0c29 0%, #1a1440 40%, #24243e 100%);
      min-height: 100vh;
    }

    .nav-glass {
      background: rgba(15, 12, 41, 0.85);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.06);
      backdrop-filter: blur(15px);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .dots-pattern {
      background-image: radial-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px);
      background-size: 30px 30px;
    }

    .rank-row {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.04);
      transition: all 0.3s;
    }

    .rank-row:hover {
      background: rgba(139, 92, 246, 0.06);
      border-color: rgba(139, 92, 246, 0.15);
    }

    .rank-gold {
      background: linear-gradient(135deg, rgba(255, 215, 0, 0.1), rgba(255, 215, 0, 0.02));
      border-color: rgba(255, 215, 0, 0.2);
    }

    .rank-silver {
      background: linear-gradient(135deg, rgba(192, 192, 192, 0.1), rgba(192, 192, 192, 0.02));
      border-color: rgba(192, 192, 192, 0.15);
    }

    .rank-bronze {
      background: linear-gradient(135deg, rgba(205, 127, 50, 0.1), rgba(205, 127, 50, 0.02));
      border-color: rgba(205, 127, 50, 0.15);
    }
  </style>
</head>

<body class="dots-pattern text-white">

  <nav class="nav-glass p-4 sticky top-0 z-50">
    <div class="max-w-screen-xl p-2 sm:px-16 mx-auto flex justify-between items-center">
      <a href="/" class="flex items-center gap-2">
        <div
          class="w-10 h-10 rounded-xl bg-gradient-to-br from-violet-500 to-purple-600 flex items-center justify-center shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24"
            stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <span class="text-white text-xl font-bold">EduVerse</span>
      </a>
      <div class="hidden md:flex items-center space-x-6 text-sm font-medium">
        <a href="/" class="text-gray-400 hover:text-white transition">Home</a>
        <% if (user && user.role !=='user' ) { %>
          <a href="/admin/quiz" class="text-gray-400 hover:text-white transition">Admin</a>
          <a href="/contacts" class="text-gray-400 hover:text-white transition">Queries</a>
          <% } %>
            <a href="/courses" class="text-gray-400 hover:text-white transition">Courses</a>
            <a href="/leaderboard" class="text-violet-400 font-semibold">Results</a>
            <a href="/contact" class="text-gray-400 hover:text-white transition">Contact</a>
            <a href="/profile" class="text-gray-400 hover:text-white transition">
              <span
                class="bg-violet-500/20 border border-violet-500/30 text-violet-300 px-3 py-1 rounded-lg text-xs font-semibold">
                <%= user.name %>
              </span>
            </a>
            <a href="/logout" class="text-gray-500 hover:text-red-400 transition">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
            </a>
      </div>
    </div>
  </nav>

  <div class="max-w-screen-lg p-4 sm:px-16 mx-auto py-8">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-extrabold mb-2">🏆 Leaderboard</h1>
      <p class="text-gray-500 text-sm">Top performers ranked by quiz accuracy</p>
    </div>

    <div class="glass-card rounded-2xl p-6">
      <% if (leaderboard.length> 0) { %>
        <!-- Header -->
        <div class="grid grid-cols-3 gap-4 px-5 py-3 mb-3 text-xs font-bold text-gray-500 uppercase tracking-wider">
          <span>Rank</span>
          <span>Student</span>
          <span class="text-right">Accuracy</span>
        </div>
        <!-- Rows -->
        <div class="space-y-2">
          <% leaderboard.forEach((entry, index)=> { %>
            <div
              class="rank-row <%= index === 0 ? 'rank-gold' : index === 1 ? 'rank-silver' : index === 2 ? 'rank-bronze' : '' %> rounded-xl px-5 py-4 grid grid-cols-3 gap-4 items-center">
              <div class="flex items-center gap-3">
                <% if (index===0) { %>
                  <span class="text-2xl">🥇</span>
                  <% } else if (index===1) { %>
                    <span class="text-2xl">🥈</span>
                    <% } else if (index===2) { %>
                      <span class="text-2xl">🥉</span>
                      <% } else { %>
                        <span
                          class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center text-sm font-bold text-gray-400">
                          <%= index + 1 %>
                        </span>
                        <% } %>
              </div>
              <div class="flex items-center gap-3">
                <div
                  class="w-8 h-8 rounded-full bg-gradient-to-br from-violet-500 to-purple-600 flex items-center justify-center text-xs font-bold">
                  <%= entry.name ? entry.name.charAt(0).toUpperCase() : 'U' %>
                </div>
                <span class="font-semibold text-sm text-white">
                  <%= entry.name %>
                </span>
              </div>
              <div class="text-right">
                <span
                  class="font-bold text-sm <%= index === 0 ? 'text-yellow-400' : index === 1 ? 'text-gray-300' : index === 2 ? 'text-amber-600' : 'text-emerald-400' %>">
                  <%= !isNaN(entry.accuracy) ? parseFloat(entry.accuracy).toFixed(1) : '0.0' %>%
                </span>
              </div>
            </div>
            <% }) %>
        </div>
        <% } else { %>
          <div class="text-center py-12">
            <p class="text-gray-400">No results available yet.</p>
          </div>
          <% } %>
    </div>
  </div>
</body>

</html>