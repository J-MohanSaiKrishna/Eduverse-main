<!DOCTYPE html>
<html lang="en" 
      x-data="{ darkMode: localStorage.getItem('darkMode') === 'true' || (!('darkMode' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches) }" 
      x-init="$watch('darkMode', val => localStorage.setItem('darkMode', val)); darkMode ? document.documentElement.classList.add('dark') : document.documentElement.classList.remove('dark')" 
      :class="{ 'dark': darkMode }">

<head>
  <%- include('partials/head', { title: 'Student Leaderboard' }) %>
  <style>
    .rank-gold {
      background: linear-gradient(135deg, rgba(251, 191, 36, 0.15), rgba(245, 158, 11, 0.05));
      border: 1px solid rgba(245, 158, 11, 0.3);
    }
    .rank-silver {
      background: linear-gradient(135deg, rgba(148, 163, 184, 0.15), rgba(100, 116, 139, 0.05));
      border: 1px solid rgba(148, 163, 184, 0.3);
    }
    .rank-bronze {
      background: linear-gradient(135deg, rgba(217, 119, 6, 0.12), rgba(180, 83, 9, 0.04));
      border: 1px solid rgba(217, 119, 6, 0.3);
    }
  </style>
</head>

<body class="dots-pattern bg-slate-50 dark:bg-[#0f0c29] text-slate-800 dark:text-white transition-colors duration-300 min-h-screen flex flex-col"
      :style="darkMode ? 'background: linear-gradient(180deg, #0f0c29 0%, #1a1440 30%, #1e1848 60%, #24243e 100%);' : 'background: #f8fafc;'">

  <!-- Ambient Glow -->
  <div class="orb orb-purple w-96 h-96 -top-20 right-10"></div>
  <div class="orb orb-pink w-80 h-80 bottom-10 left-10"></div>

  <!-- Navbar Component -->
  <%- include('partials/navbar') %>

  <!-- Main Content -->
  <main class="flex-1 max-w-screen-lg w-full px-4 sm:px-8 mx-auto py-10 relative z-10">
    
    <!-- Header -->
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 dark:bg-amber-500/15 border border-amber-200 dark:border-amber-500/30 text-amber-800 dark:text-amber-300 text-xs font-semibold mb-3">
        <span>🏆 Hall of Fame</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Student Leaderboard
      </h1>
      <p class="text-slate-500 dark:text-slate-400 text-sm mt-1 max-w-md mx-auto">
        Celebrating top quiz performers ranked by cumulative accuracy and consistency.
      </p>
    </div>

    <!-- Leaderboard Card Container -->
    <div class="glass-card rounded-2xl p-6 sm:p-8">
      <% if (leaderboard && leaderboard.length > 0) { %>
        
        <!-- Table Column Headers -->
        <div class="grid grid-cols-12 gap-4 px-5 py-3 mb-2 text-xs font-bold text-slate-400 uppercase tracking-wider border-b border-slate-200/80 dark:border-white/10">
          <div class="col-span-2 sm:col-span-1">Rank</div>
          <div class="col-span-6 sm:col-span-7">Student</div>
          <div class="col-span-4 text-right">Avg Accuracy</div>
        </div>

        <!-- Leaderboard Rows -->
        <div class="space-y-2.5">
          <% leaderboard.forEach((entry, index) => { %>
            <% 
              let medalClass = '';
              let badgeColor = 'bg-slate-100 dark:bg-white/5 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-white/5';
              if (index === 0) {
                medalClass = 'rank-gold';
              } else if (index === 1) {
                medalClass = 'rank-silver';
              } else if (index === 2) {
                medalClass = 'rank-bronze';
              }
            %>
            <div class="glass-item <%= medalClass %> rounded-2xl px-5 py-3.5 grid grid-cols-12 gap-4 items-center transition-transform">
              
              <!-- Rank Identifier -->
              <div class="col-span-2 sm:col-span-1 flex items-center">
                <% if (index === 0) { %>
                  <span class="text-2xl" title="First Place">🥇</span>
                <% } else if (index === 1) { %>
                  <span class="text-2xl" title="Second Place">🥈</span>
                <% } else if (index === 2) { %>
                  <span class="text-2xl" title="Third Place">🥉</span>
                <% } else { %>
                  <span class="w-8 h-8 rounded-xl bg-slate-100 dark:bg-white/5 text-slate-500 dark:text-slate-400 flex items-center justify-center text-xs font-bold">
                    #<%= index + 1 %>
                  </span>
                <% } %>
              </div>

              <!-- Student Profile Avatar & Name -->
              <div class="col-span-6 sm:col-span-7 flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-violet-600 to-indigo-500 text-white flex items-center justify-center text-xs font-bold shadow-sm flex-shrink-0">
                  <%= entry.name ? entry.name.charAt(0).toUpperCase() : 'U' %>
                </div>
                <div class="min-w-0">
                  <p class="font-bold text-sm text-slate-900 dark:text-white truncate">
                    <%= entry.name %>
                  </p>
                  <p class="text-[11px] text-slate-400 hidden sm:block">Enrolled Learner</p>
                </div>
              </div>

              <!-- Score Percentage -->
              <div class="col-span-4 text-right">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl text-xs font-bold <%= index === 0 ? 'bg-amber-100 text-amber-800 dark:bg-amber-500/20 dark:text-amber-300' : index === 1 ? 'bg-slate-200 text-slate-800 dark:bg-white/10 dark:text-slate-200' : index === 2 ? 'bg-amber-50 text-amber-900 dark:bg-amber-600/20 dark:text-amber-400' : 'bg-emerald-50 text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-300' %>">
                  <%= !isNaN(entry.accuracy) ? parseFloat(entry.accuracy).toFixed(1) : '0.0' %>%
                </span>
              </div>

            </div>
          <% }) %>
        </div>

      <% } else { %>
        <div class="text-center py-16">
          <div class="w-16 h-16 rounded-2xl bg-amber-100 dark:bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">No quiz results yet</h3>
          <p class="text-slate-500 dark:text-slate-400 text-sm max-w-sm mx-auto mb-6">
            Be the first student to finish a quiz challenge and claim the top of the leaderboard!
          </p>
          <a href="/" class="btn-gradient px-5 py-2.5 rounded-xl text-xs font-semibold shadow-md inline-block">
            Take a Quiz Now
          </a>
        </div>
      <% } %>
    </div>
  </main>

  <!-- Footer Component -->
  <%- include('partials/footer') %>

</body>
</html>