<!DOCTYPE html>
<html lang="en" 
      x-data="{ darkMode: localStorage.getItem('darkMode') === 'true' || (!('darkMode' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches) }" 
      x-init="$watch('darkMode', val => localStorage.setItem('darkMode', val)); darkMode ? document.documentElement.classList.add('dark') : document.documentElement.classList.remove('dark')" 
      :class="{ 'dark': darkMode }">

<head>
  <%- include('partials/head', { title: 'Admin — Create Quiz' }) %>
</head>

<body class="dots-pattern bg-slate-50 dark:bg-[#0f0c29] text-slate-800 dark:text-white transition-colors duration-300 min-h-screen flex flex-col"
      :style="darkMode ? 'background: linear-gradient(180deg, #0f0c29 0%, #1a1440 30%, #1e1848 60%, #24243e 100%);' : 'background: #f8fafc;'">

  <!-- Ambient Background Orbs -->
  <div class="orb orb-purple w-96 h-96 -top-20 -right-20"></div>

  <!-- Navbar Component -->
  <%- include('partials/navbar') %>

  <!-- Main Container -->
  <main class="flex-1 max-w-screen-xl w-full px-4 sm:px-8 lg:px-12 mx-auto py-10 relative z-10">
    
    <!-- Header -->
    <div class="mb-8 flex items-center justify-between">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-100 dark:bg-violet-500/15 border border-violet-200 dark:border-violet-500/30 text-violet-700 dark:text-violet-300 text-xs font-semibold mb-2">
          <span>📝 Quiz Authoring</span>
        </div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Create New Quiz</h1>
        <p class="text-slate-500 dark:text-slate-400 text-sm mt-0.5">Define quiz properties, multiple-choice questions, and response criteria.</p>
      </div>

      <a href="/admin/quiz" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 hover:border-violet-400 transition-all flex items-center gap-1.5 shadow-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        Back to Quizzes
      </a>
    </div>

    <!-- Form -->
    <form action="/admin/quiz/store" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left: Questions Builder (8 cols) -->
        <div class="lg:col-span-8 space-y-6">
          <div class="glass-card rounded-2xl p-6 sm:p-8">
            <h2 class="text-base font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-violet-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              Basic Information
            </h2>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">Quiz Name *</label>
              <input type="text" name="quiz_name" required placeholder="e.g. Modern JavaScript Fundamentals"
                     class="input-field w-full px-4 py-3 rounded-xl text-sm font-medium">
            </div>
          </div>

          <!-- Dynamic Questions List -->
          <div id="questions" class="space-y-4">
            
            <!-- Question 1 Template -->
            <div class="question-card glass-card rounded-2xl p-6 relative">
              <div class="flex items-center justify-between mb-4 border-b border-slate-200/80 dark:border-white/10 pb-3">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-bold bg-violet-100 dark:bg-violet-500/20 text-violet-700 dark:text-violet-300">
                  Question 1
                </span>
              </div>

              <div class="space-y-4">
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">Question Prompt *</label>
                  <input type="text" name="questions[0][question]" required placeholder="Enter the question text here..."
                         class="input-field w-full px-4 py-2.5 rounded-xl text-sm font-medium">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div>
                    <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Option A *</label>
                    <input type="text" name="questions[0][option_a]" required placeholder="Option A"
                           class="input-field w-full px-3.5 py-2 rounded-xl text-sm">
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Option B *</label>
                    <input type="text" name="questions[0][option_b]" required placeholder="Option B"
                           class="input-field w-full px-3.5 py-2 rounded-xl text-sm">
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Option C *</label>
                    <input type="text" name="questions[0][option_c]" required placeholder="Option C"
                           class="input-field w-full px-3.5 py-2 rounded-xl text-sm">
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Option D *</label>
                    <input type="text" name="questions[0][option_d]" required placeholder="Option D"
                           class="input-field w-full px-3.5 py-2 rounded-xl text-sm">
                  </div>
                </div>

                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 mb-1.5">Correct Answer Key *</label>
                  <input type="text" name="questions[0][correct_answer]" required placeholder="e.g. a, b, c, or d (or full correct string)"
                         class="input-field w-full px-4 py-2.5 rounded-xl text-sm font-medium border-emerald-500/40">
                </div>
              </div>
            </div>

          </div>

          <!-- Add Question Button -->
          <button type="button" id="addQuestion"
                  class="w-full py-3.5 rounded-2xl border-2 border-dashed border-violet-400/50 hover:border-violet-500 dark:border-violet-500/30 dark:hover:border-violet-400 text-violet-600 dark:text-violet-400 hover:bg-violet-50 dark:hover:bg-violet-500/10 font-bold text-xs flex items-center justify-center gap-2 transition-all">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" /></svg>
            <span>Add Another Question</span>
          </button>
        </div>

        <!-- Right: Settings Sidebar (4 cols) -->
        <div class="lg:col-span-4">
          <div class="glass-card rounded-2xl p-6 sm:p-8 space-y-6 lg:sticky lg:top-28 shadow-xl">
            <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2 pb-4 border-b border-slate-200/80 dark:border-white/10">
              <svg class="w-5 h-5 text-violet-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              Quiz Configuration
            </h2>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">Description</label>
              <textarea name="description" rows="4" placeholder="Brief summary of quiz coverage..."
                        class="input-field w-full px-4 py-3 rounded-xl text-sm font-medium resize-none"></textarea>
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">Send Email Notification?</label>
              <select name="send_email" required class="input-field w-full px-4 py-3 rounded-xl text-sm font-medium">
                <option value="0">No, do not notify</option>
                <option value="1">Yes, send notification</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">Allow Student Reattempts?</label>
              <select name="allow_reattempt" required class="input-field w-full px-4 py-3 rounded-xl text-sm font-medium">
                <option value="1">Yes, students can retake</option>
                <option value="0">No, single attempt only</option>
              </select>
            </div>

            <div class="pt-4 border-t border-slate-200/80 dark:border-white/10">
              <button type="submit" class="btn-gradient w-full py-3.5 rounded-xl font-bold text-sm tracking-wide shadow-lg flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                <span>Publish Quiz</span>
              </button>
            </div>

          </div>
        </div>

      </div>
    </form>

  </main>

  <!-- Footer Component -->
  <%- include('partials/footer') %>

  <!-- Add Question Script -->
  <script>
    let questionIndex = 1;
    document.getElementById('addQuestion').addEventListener('click', function () {
      const newQuestion = `
        <div class="question-card glass-card rounded-2xl p-6 relative">
          <div class="flex items-center justify-between mb-4 border-b border-slate-200/80 dark:border-white/10 pb-3">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-bold bg-violet-100 dark:bg-violet-500/20 text-violet-700 dark:text-violet-300">
              Question ${questionIndex + 1}
            </span>
          </div>

          <div class="space-y-4">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">Question Prompt *</label>
              <input type="text" name="questions[${questionIndex}][question]" required placeholder="Enter the question text here..."
                     class="input-field w-full px-4 py-2.5 rounded-xl text-sm font-medium">
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Option A *</label>
                <input type="text" name="questions[${questionIndex}][option_a]" required placeholder="Option A"
                       class="input-field w-full px-3.5 py-2 rounded-xl text-sm">
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Option B *</label>
                <input type="text" name="questions[${questionIndex}][option_b]" required placeholder="Option B"
                       class="input-field w-full px-3.5 py-2 rounded-xl text-sm">
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Option C *</label>
                <input type="text" name="questions[${questionIndex}][option_c]" required placeholder="Option C"
                       class="input-field w-full px-3.5 py-2 rounded-xl text-sm">
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Option D *</label>
                <input type="text" name="questions[${questionIndex}][option_d]" required placeholder="Option D"
                       class="input-field w-full px-3.5 py-2 rounded-xl text-sm">
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 mb-1.5">Correct Answer Key *</label>
              <input type="text" name="questions[${questionIndex}][correct_answer]" required placeholder="e.g. a, b, c, or d"
                     class="input-field w-full px-4 py-2.5 rounded-xl text-sm font-medium border-emerald-500/40">
            </div>
          </div>
        </div>`;
      document.getElementById('questions').insertAdjacentHTML('beforeend', newQuestion);
      questionIndex++;
    });
  </script>

</body>
</html>
