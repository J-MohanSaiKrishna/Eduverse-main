<!DOCTYPE html>
<html lang="en" x-data="{ darkMode: localStorage.getItem('darkMode') === 'true' || (!('darkMode' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches) }" x-init="$watch('darkMode', val => localStorage.setItem('darkMode', val)); darkMode ? document.documentElement.classList.add('dark') : document.documentElement.classList.remove('dark')" :class="{ 'dark': darkMode }">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — EduVerse</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="shortcut icon" href="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTAQHwjXyAiIxUCnh3-cFywq0K4ZmDFo20YAw&s">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { font-family: 'Poppins', sans-serif; }

    /* Hardcoded body background removed for dark mode */

    /* Animated gradient orbs */
    .orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.5;
      animation: float 8s ease-in-out infinite;
    }
    .orb-1 {
      width: 400px; height: 400px;
      background: linear-gradient(135deg, #667eea, #764ba2);
      top: -100px; left: -100px;
      animation-delay: 0s;
    }
    .orb-2 {
      width: 350px; height: 350px;
      background: linear-gradient(135deg, #f093fb, #f5576c);
      bottom: -80px; right: -80px;
      animation-delay: -3s;
    }
    .orb-3 {
      width: 250px; height: 250px;
      background: linear-gradient(135deg, #4facfe, #00f2fe);
      top: 50%; right: 20%;
      animation-delay: -5s;
    }
    .orb-4 {
      width: 200px; height: 200px;
      background: linear-gradient(135deg, #43e97b, #38f9d7);
      bottom: 20%; left: 10%;
      animation-delay: -2s;
    }

    @keyframes float {
      0%, 100% { transform: translate(0, 0) scale(1); }
      25% { transform: translate(30px, -40px) scale(1.05); }
      50% { transform: translate(-20px, 20px) scale(0.95); }
      75% { transform: translate(40px, 30px) scale(1.02); }
    }

    /* Particle grid */
    .grid-pattern {
      position: absolute;
      inset: 0;
      background-image: 
        linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
      background-size: 60px 60px;
    }

    /* Glass card */
    .glass-card {
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255,255,255,0.1);
    }

    .input-field {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      transition: all 0.3s ease;
    }
    .input-field:focus {
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(139, 92, 246, 0.6);
      box-shadow: 0 0 20px rgba(139, 92, 246, 0.15);
    }

    .btn-glow {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }
    .btn-glow::before {
      content: '';
      position: absolute;
      top: 0; left: -100%;
      width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
      transition: left 0.5s;
    }
    .btn-glow:hover::before { left: 100%; }
    .btn-glow:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(102, 126, 234, 0.4);
    }

    /* Floating shapes */
    .shape {
      position: absolute;
      opacity: 0.1;
      animation: drift 20s linear infinite;
    }
    @keyframes drift {
      0% { transform: translateY(100vh) rotate(0deg); }
      100% { transform: translateY(-100vh) rotate(720deg); }
    }

    .fade-in {
      animation: fadeIn 0.8s ease-out forwards;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="flex justify-center items-center min-h-screen relative bg-gray-50 dark:bg-[#0f0c29] text-gray-800 dark:text-white transition-colors duration-300 min-h-screen" :style="darkMode ? 'background: linear-gradient(180deg, #0f0c29 0%, #1a1440 30%, #1e1848 60%, #24243e 100%);' : 'background: #f8fafc;'">

  <!-- Background effects -->
  <div class="grid-pattern"></div>
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>
  <div class="orb orb-4"></div>

  <!-- Floating geometric shapes -->
  <div class="shape" style="left:10%; animation-delay:-2s; animation-duration:15s;">
    <svg width="40" height="40" viewBox="0 0 40 40"><rect width="40" height="40" fill="white" rx="8"/></svg>
  </div>
  <div class="shape" style="left:30%; animation-delay:-5s; animation-duration:18s;">
    <svg width="30" height="30" viewBox="0 0 30 30"><circle cx="15" cy="15" r="15" fill="white"/></svg>
  </div>
  <div class="shape" style="left:60%; animation-delay:-8s; animation-duration:22s;">
    <svg width="35" height="35" viewBox="0 0 35 35"><polygon points="17.5,0 35,35 0,35" fill="white"/></svg>
  </div>
  <div class="shape" style="left:80%; animation-delay:-3s; animation-duration:16s;">
    <svg width="25" height="25" viewBox="0 0 25 25"><rect width="25" height="25" fill="white" rx="5"/></svg>
  </div>
  <div class="shape" style="left:45%; animation-delay:-10s; animation-duration:20s;">
    <svg width="20" height="20" viewBox="0 0 20 20"><circle cx="10" cy="10" r="10" fill="white"/></svg>
  </div>

  <!-- Login Card -->
  <div class="glass-card rounded-2xl p-8 w-full max-w-md mx-4 relative z-10 fade-in">
    <!-- Logo -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-violet-500 to-purple-600 mb-4 shadow-lg">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>
      <h1 class="text-3xl font-bold text-white mb-1">Welcome Back</h1>
      <p class="text-gray-400 text-sm">Sign in to continue your learning journey</p>
    </div>

    <form action="/login" method="POST" class="space-y-5">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    
      <% if (error && error.length > 0) { %>
        <div class="p-3 text-sm text-red-300 bg-red-500/20 rounded-xl border border-red-500/30 flex items-center gap-2">
          <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
          <%= error %>
        </div>
      <% } %>      
    
      <div>
        <label for="email" class="block text-sm font-medium text-gray-300 mb-2">Email Address</label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/></svg>
          </span>
          <input type="email" name="email" id="email" required placeholder="you@example.com"
                 class="input-field w-full pl-10 pr-4 py-3 rounded-xl text-white placeholder-gray-500 outline-none">
        </div>
      </div>
      <div>
        <label for="password" class="block text-sm font-medium text-gray-300 mb-2">Password</label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          </span>
          <input type="password" name="password" id="password" required placeholder="••••••••"
                 class="input-field w-full pl-10 pr-4 py-3 rounded-xl text-white placeholder-gray-500 outline-none">
        </div>
      </div>
      
      <button type="submit" class="btn-glow w-full text-white py-3.5 rounded-xl font-semibold text-base tracking-wide">
        Sign In
      </button>
    </form>

    <div class="mt-6 text-center space-y-2">
      <a href="/register" class="text-violet-400 hover:text-violet-300 transition-colors text-sm block font-medium">
        Don't have an account? <span class="underline">Create one</span>
      </a>
      <a href="/forgot" class="text-gray-500 hover:text-gray-400 transition-colors text-sm block">
        Forgot your password?
      </a>
    </div>
  </div>

</body>
</html>
