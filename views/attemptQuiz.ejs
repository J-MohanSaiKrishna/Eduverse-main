<!DOCTYPE html>
<html lang="en" 
      x-data="{ darkMode: localStorage.getItem('darkMode') === 'true' || (!('darkMode' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches) }" 
      x-init="$watch('darkMode', val => localStorage.setItem('darkMode', val)); darkMode ? document.documentElement.classList.add('dark') : document.documentElement.classList.remove('dark')" 
      :class="{ 'dark': darkMode }">

<head>
  <%- include('partials/head', { title: 'Take Quiz Challenge' }) %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body class="dots-pattern bg-slate-50 dark:bg-[#0f0c29] text-slate-800 dark:text-white transition-colors duration-300 min-h-screen flex flex-col"
      :style="darkMode ? 'background: linear-gradient(180deg, #0f0c29 0%, #1a1440 30%, #1e1848 60%, #24243e 100%);' : 'background: #f8fafc;'">

  <!-- Ambient Glow -->
  <div class="orb orb-purple w-96 h-96 -top-20 -left-20"></div>
  <div class="orb orb-cyan w-80 h-80 bottom-10 right-10"></div>

  <!-- Navbar Component -->
  <%- include('partials/navbar') %>

  <!-- Main Quiz Container -->
  <main class="flex-1 max-w-screen-xl w-full px-4 sm:px-8 lg:px-12 mx-auto py-10 relative z-10">
    
    <div class="glass-card rounded-3xl p-6 sm:p-10 shadow-2xl flex flex-col lg:flex-row gap-10">
      
      <!-- Quiz Questions Form Column -->
      <div class="w-full lg:w-3/5 space-y-6">
        <div class="flex items-center justify-between pb-6 border-b border-slate-200/80 dark:border-white/10">
          <div>
            <div class="inline-flex items-center gap-1.5 text-xs font-bold text-violet-600 dark:text-violet-400 uppercase tracking-wider mb-1">
              <span>Quiz Assessment</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">Knowledge Check</h1>
          </div>
          <div id="score" class="text-base sm:text-lg font-bold text-emerald-600 dark:text-emerald-400 px-3 py-1.5 rounded-xl bg-emerald-50 dark:bg-emerald-500/15 border border-emerald-200 dark:border-emerald-500/30 hidden">
            <!-- Dynamically populated score -->
          </div>
        </div>

        <form id="quizForm" action="/quiz/<%= quiz_id %>/attempt" method="POST" class="space-y-6">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

          <% questions.forEach((question, qIdx) => { %>
            <div class="p-6 rounded-2xl bg-white dark:bg-white/[0.03] border border-slate-200/80 dark:border-white/10 shadow-sm space-y-4">
              <div class="flex items-start gap-3">
                <span class="w-7 h-7 rounded-xl bg-violet-100 dark:bg-violet-500/20 text-violet-700 dark:text-violet-300 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">
                  <%= qIdx + 1 %>
                </span>
                <p class="font-bold text-base text-slate-900 dark:text-white leading-relaxed">
                  <%= question.question %>
                </p>
              </div>

              <div class="space-y-2.5 pl-10">
                <label class="block p-3.5 rounded-xl border border-slate-200 dark:border-white/10 hover:bg-slate-50 dark:hover:bg-white/5 cursor-pointer transition-all option-label">
                  <div class="flex items-center gap-3">
                    <input type="radio" name="answers[<%= question.id %>]" value="a" required class="w-4 h-4 text-violet-600 focus:ring-violet-500">
                    <span class="text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-200"><%= question.option_a %></span>
                  </div>
                </label>

                <label class="block p-3.5 rounded-xl border border-slate-200 dark:border-white/10 hover:bg-slate-50 dark:hover:bg-white/5 cursor-pointer transition-all option-label">
                  <div class="flex items-center gap-3">
                    <input type="radio" name="answers[<%= question.id %>]" value="b" required class="w-4 h-4 text-violet-600 focus:ring-violet-500">
                    <span class="text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-200"><%= question.option_b %></span>
                  </div>
                </label>

                <label class="block p-3.5 rounded-xl border border-slate-200 dark:border-white/10 hover:bg-slate-50 dark:hover:bg-white/5 cursor-pointer transition-all option-label">
                  <div class="flex items-center gap-3">
                    <input type="radio" name="answers[<%= question.id %>]" value="c" required class="w-4 h-4 text-violet-600 focus:ring-violet-500">
                    <span class="text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-200"><%= question.option_c %></span>
                  </div>
                </label>

                <label class="block p-3.5 rounded-xl border border-slate-200 dark:border-white/10 hover:bg-slate-50 dark:hover:bg-white/5 cursor-pointer transition-all option-label">
                  <div class="flex items-center gap-3">
                    <input type="radio" name="answers[<%= question.id %>]" value="d" required class="w-4 h-4 text-violet-600 focus:ring-violet-500">
                    <span class="text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-200"><%= question.option_d %></span>
                  </div>
                </label>
              </div>
            </div>
          <% }) %>

          <button type="submit" id="submitBtn"
                  class="btn-gradient w-full py-4 rounded-2xl font-bold text-sm tracking-wide shadow-xl flex items-center justify-center gap-2">
            <span>Submit Answers & Calculate Score</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </button>
        </form>
      </div>

      <!-- Feedback & Analytics Column (Revealed upon Submission) -->
      <div id="feedback" class="w-full lg:w-2/5 hidden flex-col space-y-6">
        <div class="p-6 rounded-2xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 shadow-md">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-300 flex items-center justify-center">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
              <h2 class="text-lg font-bold text-emerald-900 dark:text-emerald-200">Results Summary</h2>
              <p class="text-xs text-emerald-700 dark:text-emerald-400">Personalized feedback analysis</p>
            </div>
          </div>

          <div id="feedbackContent" class="text-xs sm:text-sm text-emerald-900 dark:text-emerald-100 leading-relaxed bg-white/70 dark:bg-black/30 p-4 rounded-xl border border-emerald-200/50 dark:border-white/5 mb-6">
          </div>

          <div class="w-full h-64 relative">
            <canvas id="myChart" class="w-full h-full"></canvas>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <a href="/" class="btn-gradient flex-1 py-3 rounded-xl text-center font-bold text-xs shadow-md">
            Explore More Quizzes
          </a>
          <a href="/leaderboard" class="px-4 py-3 rounded-xl text-center font-bold text-xs bg-slate-100 dark:bg-white/10 text-slate-700 dark:text-slate-200 hover:bg-slate-200 transition-colors">
            Leaderboard
          </a>
        </div>
      </div>

    </div>

  </main>

  <!-- Footer Component -->
  <%- include('partials/footer') %>

  <!-- Interactive Score & Chart Evaluation Script -->
  <script>
    var ctx = document.getElementById('myChart').getContext('2d');
    var myChart = new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels: ['Incorrect / Missed', 'Correct'],
        datasets: [{
          data: [100, 0],
          backgroundColor: [
            'rgba(244, 63, 94, 0.8)',
            'rgba(16, 185, 129, 0.8)',
          ],
          borderColor: [
            'rgba(244, 63, 94, 1)',
            'rgba(16, 185, 129, 1)',
          ],
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom',
            labels: {
              boxWidth: 12,
              padding: 15,
              font: {
                family: 'Poppins',
                size: 11
              }
            }
          }
        }
      }
    });

    document.getElementById('quizForm').addEventListener('submit', async function (event) {
      event.preventDefault();
      const submitBtn = document.getElementById('submitBtn');
      submitBtn.disabled = true;
      submitBtn.innerHTML = 'Evaluating answers...';

      try {
        const formData = new FormData(this);
        const response = await fetch(this.action, {
          method: 'POST',
          headers: {
            'Accept': 'application/json',
          },
          body: new URLSearchParams(formData)
        });

        const result = await response.json();

        // Reset highlights
        document.querySelectorAll('.option-label').forEach(label => {
          label.classList.remove('bg-emerald-100', 'dark:bg-emerald-500/20', 'border-emerald-500', 'bg-rose-100', 'dark:bg-rose-500/20', 'border-rose-500');
        });

        let score = 0;

        if (result.correctAnswers && Array.isArray(result.correctAnswers)) {
          result.correctAnswers.forEach((correctAnswer) => {
            const questionId = correctAnswer.id;
            const correctOption = String(correctAnswer.correct_answer || '').trim().toLowerCase();
            const selectedOption = String(formData.get(`answers[${questionId}]`) || '').trim().toLowerCase();

            document.querySelectorAll(`input[name="answers[${questionId}]"]`).forEach(input => {
              const label = input.closest('label');
              const val = String(input.value || '').trim().toLowerCase();

              if (val === selectedOption) {
                if (val === correctOption) {
                  label.classList.add('bg-emerald-100', 'dark:bg-emerald-500/20', 'border-emerald-500');
                  score++;
                } else {
                  label.classList.add('bg-rose-100', 'dark:bg-rose-500/20', 'border-rose-500');
                }
              }

              if (val === correctOption) {
                label.classList.add('bg-emerald-100', 'dark:bg-emerald-500/20', 'border-emerald-500');
              }
            });
          });
        }

        // Show Score
        const scoreElem = document.getElementById('score');
        scoreElem.textContent = `Score: ${score} / ${result.totalQuestions || 0} (${result.score || 0}%)`;
        scoreElem.classList.remove('hidden');

        // Update Chart
        const percentage = Math.round(Number(result.score) || 0);
        myChart.data.datasets[0].data = [Math.max(0, 100 - percentage), percentage];
        myChart.update();

        // Display Feedback
        const feedbackDiv = document.getElementById('feedback');
        feedbackDiv.classList.remove('hidden');
        feedbackDiv.classList.add('flex');
        document.getElementById('feedbackContent').textContent = result.feedback || `You scored ${percentage}%. Great effort! Review incorrect questions to solidify key concepts.`;

        // Smooth scroll to results
        feedbackDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

        submitBtn.innerHTML = 'Assessment Completed';
      } catch (err) {
        console.error('Quiz evaluation error:', err);
        alert('An error occurred submitting the quiz. Please try again.');
        submitBtn.disabled = false;
        submitBtn.innerHTML = 'Submit Answers & Calculate Score';
      }
    });
  </script>

</body>
</html>