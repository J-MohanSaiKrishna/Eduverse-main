<!DOCTYPE html>
<html lang="en" 
      x-data="{ darkMode: localStorage.getItem('darkMode') === 'true' || (!('darkMode' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches) }" 
      x-init="$watch('darkMode', val => localStorage.setItem('darkMode', val)); darkMode ? document.documentElement.classList.add('dark') : document.documentElement.classList.remove('dark')" 
      :class="{ 'dark': darkMode }">

<head>
  <%- include('partials/head', { title: (user && user.name ? user.name : 'Student') + ' — Profile' }) %>
  <style>
    .profile-gradient {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
      position: relative;
      overflow: hidden;
    }
    .profile-gradient::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 30% 50%, rgba(255, 255, 255, 0.15) 0%, transparent 50%),
                  radial-gradient(circle at 70% 30%, rgba(255, 255, 255, 0.1) 0%, transparent 40%);
    }
    .avatar-ring {
      background: linear-gradient(135deg, #ffffff, rgba(255, 255, 255, 0.4));
      padding: 4px;
    }
  </style>
</head>

<body class="dots-pattern bg-slate-50 dark:bg-[#0f0c29] text-slate-800 dark:text-white transition-colors duration-300 min-h-screen flex flex-col"
      :style="darkMode ? 'background: linear-gradient(180deg, #0f0c29 0%, #1a1440 30%, #1e1848 60%, #24243e 100%);' : 'background: #f8fafc;'">

  <!-- Ambient Glow -->
  <div class="orb orb-purple w-96 h-96 -top-20 right-10"></div>
  <div class="orb orb-pink w-80 h-80 bottom-10 left-10"></div>

  <!-- Navbar Component -->
  <%- include('partials/navbar') %>

  <!-- Main Profile Container -->
  <main class="flex-1 max-w-screen-lg w-full px-4 sm:px-8 mx-auto py-10 relative z-10">
    
    <!-- Profile Banner Hero -->
    <div class="profile-gradient rounded-3xl p-8 sm:p-10 mb-8 shadow-xl text-white">
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 text-center sm:text-left relative z-10">
        
        <!-- Avatar Ring -->
        <div class="avatar-ring rounded-2xl shadow-lg">
          <div class="w-24 h-24 rounded-2xl bg-slate-900/90 flex items-center justify-center backdrop-blur-md">
            <span class="text-4xl font-extrabold text-white">
              <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
            </span>
          </div>
        </div>

        <!-- User Meta Info -->
        <div class="space-y-1.5 flex-1">
          <div class="flex flex-col sm:flex-row sm:items-center gap-2">
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
              <%= user.name %>
            </h1>
            <span class="inline-flex items-center gap-1 px-3 py-0.5 rounded-full text-xs font-bold bg-white/20 backdrop-blur-md border border-white/20 capitalize w-fit mx-auto sm:mx-0">
              <%= user.role %>
            </span>
          </div>
          <p class="text-white/80 text-sm font-medium">
            <%= user.email %>
          </p>
          <div class="pt-2 flex items-center justify-center sm:justify-start gap-3 text-xs text-white/90">
            <span class="inline-flex items-center gap-1.5 bg-black/20 px-3 py-1 rounded-full">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Active Account
            </span>
            <span>ID: #<%= user.id %></span>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <a href="/logout" class="px-4 py-2 rounded-xl text-xs font-bold bg-white/15 hover:bg-white/25 border border-white/20 text-white transition-all shadow-sm">
            Sign Out
          </a>
        </div>
      </div>
    </div>

    <!-- User Information Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-8">
      
      <!-- Email -->
      <div class="glass-card rounded-2xl p-6">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-8 h-8 rounded-lg bg-violet-100 dark:bg-violet-500/20 text-violet-600 dark:text-violet-300 flex items-center justify-center">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </div>
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Email Address</span>
        </div>
        <p class="text-sm sm:text-base font-bold text-slate-800 dark:text-white pl-11">
          <%= user.email %>
        </p>
      </div>

      <!-- Phone -->
      <div class="glass-card rounded-2xl p-6">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-8 h-8 rounded-lg bg-cyan-100 dark:bg-cyan-500/20 text-cyan-600 dark:text-cyan-300 flex items-center justify-center">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          </div>
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Phone Number</span>
        </div>
        <p class="text-sm sm:text-base font-bold text-slate-800 dark:text-white pl-11">
          <%= user.phone || 'Not specified' %>
        </p>
      </div>

      <!-- Gender -->
      <div class="glass-card rounded-2xl p-6">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-8 h-8 rounded-lg bg-pink-100 dark:bg-pink-500/20 text-pink-600 dark:text-pink-300 flex items-center justify-center">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
          </div>
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Gender</span>
        </div>
        <p class="text-sm sm:text-base font-bold text-slate-800 dark:text-white pl-11 capitalize">
          <%= user.gender || 'Not specified' %>
        </p>
      </div>

      <!-- DOB -->
      <div class="glass-card rounded-2xl p-6">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-8 h-8 rounded-lg bg-amber-100 dark:bg-amber-500/20 text-amber-600 dark:text-amber-300 flex items-center justify-center">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          </div>
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Date of Birth</span>
        </div>
        <p class="text-sm sm:text-base font-bold text-slate-800 dark:text-white pl-11">
          <%= user.dob || 'Not specified' %>
        </p>
      </div>

      <!-- Location -->
      <div class="glass-card rounded-2xl p-6 sm:col-span-2">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-300 flex items-center justify-center">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          </div>
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Location</span>
        </div>
        <p class="text-sm sm:text-base font-bold text-slate-800 dark:text-white pl-11">
          <%= user.location || 'Not specified' %>
        </p>
      </div>

    </div>

    <!-- Quick Navigation Actions -->
    <div class="flex flex-col sm:flex-row items-center gap-4">
      <a href="/" class="btn-gradient w-full sm:flex-1 py-3.5 rounded-xl text-center font-bold text-xs shadow-md">
        Take a Quiz Assessment
      </a>
      <a href="/courses" class="w-full sm:flex-1 py-3.5 rounded-xl text-center font-bold text-xs bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 hover:border-violet-400 text-slate-700 dark:text-slate-200 transition-colors shadow-sm">
        Explore Free Courses
      </a>
    </div>

  </main>

  <!-- Footer Component -->
  <%- include('partials/footer') %>

</body>
</html>